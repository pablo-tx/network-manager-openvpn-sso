[Unit]
Description=OpenVPN SSO Browser Launcher

[Service]
Type=oneshot
KillMode=process
# Delete each URL file before opening it: a leftover file would re-trigger
# the path unit until it hits its trigger limit. Only http(s) URLs are
# opened, because the directory may be writable by other local users.
ExecStart=/bin/sh -c 'for f in /run/nm-openvpn-sso/$$(id -u)/*.url; do [ -f "$$f" ] || continue; url="$$(head -c 8192 "$$f")"; rm -f "$$f"; case "$$url" in https://*|http://*) xdg-open "$$url" & ;; *) echo "Ignoring non-http(s) URL in $$f" >&2 ;; esac; done; exit 0'
